% Styling for RAVEN Polish user manual (XeTeX / tectonic)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{raven-manual}[2026/11/22 RAVEN User Manual style]

\RequirePackage{fontspec}
\RequirePackage[polish]{babel}
\RequirePackage[a4paper,top=22mm,bottom=22mm,left=20mm,right=20mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tcolorbox}
\RequirePackage{listings}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds}
\RequirePackage[hidelinks,unicode]{hyperref}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{microtype}

% Fonts (Latin Modern — always available in tectonic, full Polish diacritics)
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont[Scale=0.88]{Latin Modern Mono}

% AGH / RAVEN colour palette (docs/design/README.md)
\definecolor{aghred}{HTML}{C10D14}
\definecolor{aghblack}{HTML}{000000}
\definecolor{aghink}{HTML}{212121}
\definecolor{aghmuted}{HTML}{505157}
\definecolor{aghband}{HTML}{F2F2F2}
\definecolor{aghline}{HTML}{D4D4D4}
\definecolor{aghgreen}{HTML}{006837}

% Global paragraph and list spacing (compact technical manual)
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.5pt}
\linespread{1.06}
\setlist{nosep,topsep=3pt,leftmargin=1.6em}

% Headings with AGH square accent and sharp rule
\titleformat{\section}
  {\sffamily\Large\bfseries\color{aghblack}}
  {\textcolor{aghred}{\rule[0.1ex]{0.55em}{0.55em}}\hspace{0.45em}\thesection.}
  {0.45em}
  {}
  [\vspace{-4pt}{\color{aghblack}\titlerule[1.2pt]}]
\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}
  {\sffamily\normalsize\bfseries\color{aghink}}
  {\textcolor{aghred}{\thesubsection}}
  {0.5em}
  {}
\titlespacing*{\subsection}{0pt}{9pt}{3pt}

% Header & footer
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{aghline}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{\hbox to\headwidth{\color{aghline}\leaders\hrule height \footrulewidth\hfill}}
\fancyhead[L]{\sffamily\footnotesize\color{aghmuted}RAVEN --- Instrukcja użytkownika}
\fancyhead[R]{\sffamily\footnotesize\color{aghmuted}\nouppercase{\leftmark}}
\fancyfoot[L]{\sffamily\footnotesize\color{aghmuted}Centrum Bezpieczeństwa Informacji AGH}
\fancyfoot[R]{\sffamily\footnotesize\color{aghink}\textbf{\thepage}}
\setlength{\headheight}{14pt}

% Captions
\captionsetup{
  font={small,sf},
  labelfont={bf,color=aghblack},
  textfont={color=aghmuted},
  skip=5pt
}

% Callout boxes (square corners, matching RAVEN UI)
\newtcolorbox{uwaga}[1][Uwaga]{
  colback=aghband,
  colframe=aghblack,
  leftrule=3pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  arc=0pt,
  outer arc=0pt,
  left=8pt,
  right=8pt,
  top=5pt,
  bottom=5pt,
  before skip=6pt,
  after skip=6pt,
  fonttitle=\sffamily\bfseries\small\color{aghblack},
  title=#1,
  attach title to upper={\quad}
}

\newtcolorbox{ostrzezenie}[1][Bezpieczeństwo]{
  colback=aghred!5,
  colframe=aghred,
  leftrule=3pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  arc=0pt,
  outer arc=0pt,
  left=8pt,
  right=8pt,
  top=5pt,
  bottom=5pt,
  before skip=6pt,
  after skip=6pt,
  fonttitle=\sffamily\bfseries\small\color{aghred},
  title=#1,
  attach title to upper={\quad}
}

% Code blocks
\lstset{
  basicstyle=\ttfamily\footnotesize\color{aghink},
  backgroundcolor=\color{aghband},
  frame=leftline,
  framerule=2pt,
  rulecolor=\color{aghblack},
  xleftmargin=6pt,
  framesep=5pt,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  aboveskip=5pt,
  belowskip=5pt,
  literate={ą}{{\k{a}}}1 {ć}{{\'c}}1 {ę}{{\k{e}}}1 {ł}{{\l{}}}1 {ń}{{\'n}}1
           {ó}{{\'o}}1 {ś}{{\'s}}1 {ź}{{\'z}}1 {ż}{{\.z}}1
           {Ą}{{\k{A}}}1 {Ć}{{\'C}}1 {Ę}{{\k{E}}}1 {Ł}{{\L{}}}1 {Ń}{{\'N}}1
           {Ó}{{\'O}}1 {Ś}{{\'S}}1 {Ź}{{\'Z}}1 {Ż}{{\.Z}}1
}

% Helper macros for UI elements and commands
\newcommand{\ui}[1]{\textsf{\textbf{„#1”}}}
\newcommand{\code}[1]{\texttt{\small #1}}
\newcommand{\badge}[1]{\colorbox{aghband}{\sffamily\scriptsize\textbf{#1}}}
\newcommand{\redbadge}[1]{\colorbox{aghred}{\sffamily\scriptsize\textbf{\color{white}#1}}}

% Framed screenshot macro: \screenshot[width]{filename}{caption}{label}
\newcommand{\screenshot}[4][0.96\linewidth]{%
  \begin{figure}[htbp]
    \centering
    \setlength{\fboxsep}{0pt}%
    \setlength{\fboxrule}{0.6pt}%
    \fcolorbox{aghline}{white}{\includegraphics[width=#1]{images/#2}}%
    \caption{#3}
    \label{#4}
  \end{figure}%
}

% Compact table defaults
\renewcommand{\arraystretch}{1.15}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
