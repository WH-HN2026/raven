# Copy to .env with scripts/gen-env.sh, which replaces every value "generated"
# below with a random secret. Never commit .env.

# ── RAVEN ──
# Published port of the raven service.
RAVEN_PORT=8000
# Password of the raven-db "raven" user.
RAVEN_DB_PASSWORD=generated
# raven-db is published on 127.0.0.1:<port> for dev (scripts/wt-env.sh).
RAVEN_DB_PORT=5433
# pgcrypto key for _enc columns. Losing it = losing the encrypted data.
RAVEN_ENCRYPTION_KEY=generated
# Bootstrap admin of our app, created on first start if no admin exists.
RAVEN_ADMIN_USERNAME=admin
RAVEN_ADMIN_PASSWORD=generated
# Set to true when served over HTTPS.
RAVEN_COOKIE_SECURE=false
RAVEN_SESSION_TTL=12h
# Global cap on concurrent scan batch jobs (per-batch scanner rates are divided by this).
RAVEN_MAX_WORKERS=2

# ── DefectDojo connection ──
RAVEN_DOJO_URL=http://nginx:8080
# Dojo as the browser reaches it (links to findings in the UI). Empty = RAVEN_DOJO_URL.
RAVEN_DOJO_PUBLIC_URL=http://localhost:18080
# Optional; when empty raven obtains a token with DD_ADMIN_USER/DD_ADMIN_PASSWORD.
RAVEN_DOJO_TOKEN=
RAVEN_DOJO_ORGANIZATION=RAVEN

# ── DefectDojo (deploy/dojo.compose.yml) ──
DD_PORT=18080
DD_TLS_PORT=8443
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=generated
DD_SECRET_KEY=generated
DD_CREDENTIAL_AES_256_KEY=generated

# ── OWASP ZAP (zap service, always started, internal network only) ──
# Empty disables the zap stage (builder shows "Not available").
RAVEN_ZAP_URL=http://zap:8080
RAVEN_ZAP_API_KEY=generated
