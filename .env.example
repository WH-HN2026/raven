# Copy to .env with scripts/gen-env.sh, which replaces every value "generated"
# below with a random secret. Never commit .env.

# ── ASI ──
# Published port of the asi service.
ASI_PORT=8000
# Password of the asi-db "asi" user.
ASI_DB_PASSWORD=generated
# asi-db is published on 127.0.0.1:<port> for dev (scripts/wt-env.sh).
ASI_DB_PORT=5433
# pgcrypto key for _enc columns. Losing it = losing the encrypted data.
ASI_ENCRYPTION_KEY=generated
# Bootstrap admin of our app, created on first start if no admin exists.
ASI_ADMIN_USERNAME=admin
ASI_ADMIN_PASSWORD=generated
# Set to true when served over HTTPS.
ASI_COOKIE_SECURE=false
ASI_SESSION_TTL=12h

# ── DefectDojo connection ──
ASI_DOJO_URL=http://nginx:8080
# Optional; when empty asi obtains a token with DD_ADMIN_USER/DD_ADMIN_PASSWORD.
ASI_DOJO_TOKEN=
ASI_DOJO_ORGANIZATION=ASI

# ── DefectDojo (deploy/dojo.compose.yml) ──
DD_PORT=8080
DD_TLS_PORT=8443
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=generated
DD_SECRET_KEY=generated
DD_CREDENTIAL_AES_256_KEY=generated
